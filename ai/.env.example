# Copier en ai/.env (jamais commité). Aucune valeur secrète ici.
# Adresse du backend FastAPI
VIGILIS_API_URL=http://localhost:8000
# Clé partagée avec le backend (même valeur que AI_API_KEY dans backend/.env)
VIGILIS_API_KEY=
# Identité et position de la caméra (lettres, chiffres, _ . - ; 64 caractères maximum)
CAMERA_ID=cam-webcam-1
CAMERA_LAT=6.5244
CAMERA_LNG=3.3792
